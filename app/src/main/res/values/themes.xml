<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Thème clair uniquement (mêmes couleurs que les maquettes) -->
    <style name="Base.Theme.TP_ListeContact" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/primary_light</item>
        <item name="android:windowBackground">@color/screen_background</item>
    </style>

    <style name="Theme.TP_ListeContact" parent="Base.Theme.TP_ListeContact" />

    <!-- Forme ronde pour les photos -->
    <style name="CircleImage">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!-- Barre du haut violette, texte et icônes blancs -->
    <style name="AppToolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">@color/primary</item>
        <item name="titleTextColor">@color/white</item>
        <item name="navigationIconTint">@color/white</item>
    </style>

    <!-- Bouton carré avec seulement une icône (appel, e-mail) -->
    <style name="IconOnlyButton" parent="Widget.Material3.Button">
        <item name="android:layout_width">56dp</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:layout_marginStart">8dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:padding">0dp</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">0dp</item>
        <item name="iconSize">22dp</item>
        <item name="cornerRadius">10dp</item>
    </style>

    <!-- Champ de saisie -->
    <style name="FormField" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/white</item>
        <item name="boxCornerRadiusTopStart">10dp</item>
        <item name="boxCornerRadiusTopEnd">10dp</item>
        <item name="boxCornerRadiusBottomStart">10dp</item>
        <item name="boxCornerRadiusBottomEnd">10dp</item>
    </style>
</resources>
